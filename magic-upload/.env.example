# Magic Upload — plantilla de credenciales.
#
# Copia este archivo a `.env` y rellena los valores. `.env` está en .gitignore.
# Comprueba que todo funciona con:  node scripts/verificar-credenciales.mjs
#
# Guía paso a paso: docs/PUESTA-EN-MARCHA.md

# ── Dominios ──────────────────────────────────────────────────────────────────────
# Dos dominios distintos, NO un dominio y un subdominio suyo. Ver ADR-0001.
MU_APP_DOMAIN=magicupload.es
MU_CONTENT_DOMAIN=mgup.site

# ── Cloudflare · cuenta "app" ─────────────────────────────────────────────────────
# Panel, marketing, checkout. Aquí NO se sirve contenido de usuario.
CF_APP_ACCOUNT_ID=
CF_APP_API_TOKEN=
CF_APP_ZONE_ID=

# ── Cloudflare · cuenta "contenido" ───────────────────────────────────────────────
# CUENTA DISTINTA, no otra zona de la anterior. Si esta se suspende por abuso, el
# negocio tiene que seguir en pie.
CF_CONTENT_ACCOUNT_ID=
CF_CONTENT_API_TOKEN=
CF_CONTENT_ZONE_ID=

# Bucket de R2 donde viven los sitios publicados. Lo creo yo; aquí solo va el nombre.
R2_BUCKET=mu-sites

# ── Supabase ──────────────────────────────────────────────────────────────────────
# Proyecto en Fráncfort (eu-central-1).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ⚠️ ESQUIVA RLS POR COMPLETO. Quien la tenga puede leer y escribir cualquier fila de
# cualquier cliente. Nunca en el navegador, nunca en un commit, nunca en un chat.
SUPABASE_SERVICE_ROLE_KEY=

# Conexión directa a Postgres, para aplicar las migraciones.
# Formato: postgresql://postgres:CONTRASEÑA@db.xxxxx.supabase.co:5432/postgres
SUPABASE_DB_URL=

# ── Stripe ────────────────────────────────────────────────────────────────────────
# TODAVÍA NO HACE FALTA. No se toca hasta que la asesoría valide la matriz fiscal
# (docs/facturacion.md §8). Es el punto de parada nº 2.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
